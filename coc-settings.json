{
    "coc.preferences.extensionUpdateCheck": "never",
    "suggest.noselect": true,
    "suggest.enablePreselect": false,
    "codeLens.enable": true,
	"suggest.completionItemKindLabels": {
		"class": "\ueb5b",
		"color": "\ue22b",
		"constant": "\ueb5d",
		"default": "\ue612",
		"enum": "\uea95",
		"enumMember": "\ueb5e",
		"event": "\uea86",
		"field": "\ueb5f",
		"file": "\uea7b",
		"folder": "\uea83",
		"function": "\u0192",
		"interface": "\ueb61",
		"keyword": "\ueb11",
		"method": "\uea8c",
		"module": "\ueb29",
		"operator": "\u0b64",
		"property": "\ueb65",
		"reference": "\ueb36",
		"snippet": "\ueb66",
		"struct": "\uea91",
		"text": "\ueb69",
		"typeParameter": "\uea92",
		"unit": "\uf475",
		"value": "\uf89f",
		"variable": "\uea88"
	},
    "hover.target": "float",
    "hover.floatConfig": {
        "border": true,
        "rounded": true
    },
    "go.goplsOptions": {
        "staticcheck": true,
        "semanticTokens": true,
				"completeUnimported": true,
				"deepCompletion": true
    },
    "go.checkForUpdates": "disabled",
    "semanticTokens.enable": true,

    "inlayHint.enable": false,
    "inlayHint.enableParameter": false,
    "inlayHint.display": false,
    "clangd.arguments": [
        "--background-index",
        "--completion-style=detailed",
        "--function-arg-placeholders=0",
        "--header-insertion=never"
    ],
    "colors.enable": true,
    // "coc.preferences.formatOnType": true
    "list.floatPreview": true,
    // <Esc> <C-s> <C-j/k> <C-f/b> <Tab> <CR>
    "list.insertMappings": {
      "<C-p>": "do:previewtoggle",
      "<C-u>": "do:previewup",
      "<C-d>": "do:previewdown",
      "<C-r>": "do:refresh",
      "<C-h>": "do:help"
    },
    "session.saveOnVimLeave": false,
    "list.source.files.command": "rg",
    "list.source.files.args": ["--files", "--hidden", "--glob", "!**/.git/*"],
    "list.source.mru.maxLength": 25,
    "list.source.grep.defaultOptions": ["--interactive", "--auto-preview"],

    "languageserver": {
      "proto": {
        "command": "protobuf-language-server",
        "filetypes": ["proto"],
        "settings": {
          "additional-proto-dirs": []
        }
      }
    },
		"highlight.trace": "off",
		// "html.filetypes": ["html"],
		// "html.completion.attributeDefaultValue": "singlequotes",
		// "html.autoClosingTags": false,
		// "html.validate.styles": false,
}
